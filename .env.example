# ── Gemini（選填）──────────────────────────────────────────
# 未設定時，系統只使用知識庫檢索，所有功能仍可正常示範。
GEMINI_API_KEY=""
# 請填入你的金鑰實際可使用的模型名稱
GEMINI_MODEL="gemini-3.8-flash"

# ── 伺服器 ────────────────────────────────────────────────
PORT=3000
RATE_LIMIT_PER_MINUTE=30

# 通路夥伴 API 金鑰（逗號分隔）。開發模式未設定時預設為 demo-partner-key
PARTNER_API_KEYS=""
# 營運洞察報表 /api/v1/navi/insights 的管理金鑰。開發模式未設定時預設為 demo-admin-key
ADMIN_KEY=""

# 前端示範用的通路金鑰（僅供展示；正式環境請由通路伺服器呼叫 API）
VITE_PARTNER_DEMO_KEY="demo-partner-key"
